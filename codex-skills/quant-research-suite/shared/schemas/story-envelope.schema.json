{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "goal_id",
    "story_id",
    "project_binding_sha256",
    "objective",
    "mode",
    "write_scope",
    "protected_scope",
    "depends_on",
    "acceptance",
    "external_effects",
    "cost_class",
    "baseline_workspace_sha256",
    "issued_at",
    "envelope_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "document_type": {"const": "quant_story_envelope"},
    "schema_version": {"const": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "story_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9_-]+$"
    },
    "project_binding_sha256": {"$ref": "#/$defs/sha256"},
    "objective": {"type": "string", "minLength": 1},
    "mode": {"enum": ["advisory", "read_only", "write"]},
    "write_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "protected_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z0-9_-]+$"
      }
    },
    "acceptance": {"type": "array", "minItems": 1},
    "external_effects": {"const": "none"},
    "cost_class": {"const": "no_billable_action"},
    "baseline_workspace_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at": {"type": "string"},
    "envelope_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
