{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quant-research-suite/review-receipt.schema.json",
  "title": "Snapshot-bound independent review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "goal_id",
    "review_id",
    "role",
    "status",
    "plan_revision",
    "acceptance_revision",
    "acceptance_ids",
    "workspace_sha256",
    "review_scope",
    "summary",
    "findings",
    "checked_at",
    "receipt_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "document_type": {"const": "quant_review_receipt"},
    "schema_version": {"const": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "review_id": {"$ref": "#/$defs/portableId"},
    "role": {
      "enum": [
        "integration_review",
        "architecture_review",
        "adversarial_qa",
        "terminal_critic"
      ]
    },
    "status": {"enum": ["passed", "needs_repair", "blocked"]},
    "plan_revision": {"type": "integer", "minimum": 0},
    "acceptance_revision": {"type": "integer", "minimum": 1},
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/portableId"}
    },
    "workspace_sha256": {"$ref": "#/$defs/sha256"},
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns", "sha256"],
      "properties": {
        "patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "carry_forward_from_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "status",
          "summary",
          "evidence_refs"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/portableId"},
          "severity": {"enum": ["blocking", "non_blocking", "info"]},
          "status": {"enum": ["open", "resolved"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"severity": {"const": "blocking"}},
              "required": ["severity"]
            },
            "then": {
              "properties": {
                "evidence_refs": {"minItems": 1}
              }
            }
          }
        ]
      }
    },
    "checked_at": {"type": "string", "format": "date-time"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"role": {"const": "terminal_critic"}},
        "required": ["role"]
      },
      "then": {"required": ["evidence_candidate_sha256"]}
    }
  ],
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9_-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
