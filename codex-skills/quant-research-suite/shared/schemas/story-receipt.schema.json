{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "goal_id",
    "story_id",
    "envelope_sha256",
    "status",
    "summary",
    "changed_paths",
    "claims",
    "evidence",
    "workspace_sha256",
    "completed_at",
    "receipt_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "document_type": {"const": "quant_story_receipt"},
    "schema_version": {"const": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "story_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9_-]+$"
    },
    "envelope_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "ready_for_review"},
    "summary": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array", "minItems": 1},
    "evidence": {"type": "array", "minItems": 1},
    "workspace_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "completed_at": {"type": "string"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
