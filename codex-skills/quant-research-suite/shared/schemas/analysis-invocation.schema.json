{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quant-research-suite/analysis-invocation.schema.json",
  "title": "Authoritative analysis invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "entrypoint_path",
    "entrypoint_sha256",
    "input_path",
    "input_sha256",
    "result_path",
    "result_sha256",
    "started_at",
    "completed_at",
    "exit_code",
    "binding"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "entrypoint_path": {"type": "string", "minLength": 1},
    "entrypoint_sha256": {"$ref": "#/$defs/sha256"},
    "input_path": {"type": "string", "minLength": 1},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "result_path": {"type": "string", "minLength": 1},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "exit_code": {"const": 0},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "argv",
        "entrypoint_argv_index"
      ],
      "properties": {
        "kind": {
          "enum": [
            "argv-option",
            "json-payload",
            "config-json"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "entrypoint_argv_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_artifact": {"$ref": "#/$defs/artifact"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "argv-option"}},
            "required": ["kind"]
          },
          "then": {
            "not": {"required": ["source_artifact"]}
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["json-payload", "config-json"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["source_artifact"]
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256",
        "media_type"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1}
      }
    }
  }
}
