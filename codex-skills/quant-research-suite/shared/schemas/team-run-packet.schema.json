{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quant-research-suite/team-run-packet.schema.json",
  "title": "Optional hash-bound host agent-team run packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "team_run_id",
    "owner",
    "goal_binding",
    "objective_sha256",
    "project_binding_sha256",
    "baseline",
    "baseline_snapshot",
    "snapshot_policy",
    "assurance",
    "delivery",
    "activation_reason",
    "integration_owner",
    "assignments",
    "join",
    "created_at",
    "packet_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "document_type": {"const": "quant_team_run_packet"},
    "schema_version": {"const": 2},
    "team_run_id": {"$ref": "#/$defs/portableId"},
    "owner": {"enum": ["standalone_developer", "goal"]},
    "goal_binding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goal_id",
            "plan_revision",
            "acceptance_revision"
          ],
          "properties": {
            "goal_id": {"$ref": "#/$defs/portableId"},
            "plan_revision": {"type": "integer", "minimum": 0},
            "acceptance_revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "objective_sha256": {"$ref": "#/$defs/sha256"},
    "project_binding_sha256": {"$ref": "#/$defs/sha256"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_sha256", "head", "branch"],
      "properties": {
        "workspace_sha256": {"$ref": "#/$defs/sha256"},
        "head": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "branch": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      }
    },
    "baseline_snapshot": {
      "type": "object",
      "required": [
        "snapshot_version",
        "protected_patterns",
        "sha256"
      ],
      "properties": {
        "snapshot_version": {"const": 2},
        "protected_patterns": {"$ref": "#/$defs/pathArray"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshot_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_version", "excluded_root", "protected_patterns"],
      "properties": {
        "snapshot_version": {"const": 2},
        "excluded_root": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/pathText"}
          ]
        },
        "protected_patterns": {"$ref": "#/$defs/pathArray"}
      }
    },
    "assurance": {"enum": ["light", "standard", "strict"]},
    "delivery": {"enum": ["local", "release"]},
    "activation_reason": {"type": "string", "minLength": 1},
    "integration_owner": {"$ref": "#/$defs/portableId"},
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assignment"}
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_order",
        "verification",
        "review_boundary"
      ],
      "properties": {
        "integration_order": {
          "$ref": "#/$defs/nonEmptyPortableIdArray"
        },
        "verification": {"$ref": "#/$defs/nonEmptyPortableIdArray"},
        "review_boundary": {"const": "integrated_frozen_snapshot"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"owner": {"const": "goal"}},
        "required": ["owner"]
      },
      "then": {
        "properties": {
          "goal_binding": {"type": "object"}
        }
      },
      "else": {
        "properties": {
          "goal_binding": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portableIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/portableId"}
    },
    "nonEmptyPortableIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/portableId"}
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "objective",
        "non_goals",
        "required",
        "acceptance_ids",
        "depends_on",
        "validation_group",
        "workspace_binding_sha256",
        "baseline_binding",
        "mode",
        "write_scope",
        "protected_scope",
        "expected_checks",
        "expected_evidence",
        "stop_conditions"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/portableId"},
        "role": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "non_goals": {"$ref": "#/$defs/stringArray"},
        "required": {"type": "boolean"},
        "acceptance_ids": {"$ref": "#/$defs/nonEmptyPortableIdArray"},
        "depends_on": {"$ref": "#/$defs/portableIdArray"},
        "validation_group": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/portableId"}
          ]
        },
        "workspace_binding_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "assignment_id"],
          "properties": {
            "kind": {"enum": ["packet", "assignment_final"]},
            "assignment_id": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "#/$defs/portableId"}
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {"kind": {"const": "packet"}},
                "required": ["kind"]
              },
              "then": {
                "properties": {"assignment_id": {"type": "null"}}
              },
              "else": {
                "properties": {
                  "assignment_id": {"$ref": "#/$defs/portableId"}
                }
              }
            }
          ]
        },
        "mode": {
          "enum": [
            "read_only",
            "same_workspace_sequential_write",
            "isolated_write"
          ]
        },
        "write_scope": {"$ref": "#/$defs/pathArray"},
        "protected_scope": {"$ref": "#/$defs/pathArray"},
        "expected_checks": {"$ref": "#/$defs/nonEmptyPortableIdArray"},
        "expected_evidence": {
          "$ref": "#/$defs/nonEmptyPortableIdArray"
        },
        "stop_conditions": {"$ref": "#/$defs/nonEmptyStringArray"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "read_only"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {"write_scope": {"maxItems": 0}}
          },
          "else": {
            "properties": {"write_scope": {"minItems": 1}}
          }
        }
      ]
    },
    "pathArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?!//)(?!.*\\\\).+$"
      }
    },
    "pathText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!//)(?!.*\\\\).+$"
    }
  }
}
