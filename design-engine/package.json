{
  "name": "@quant/design-engine",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "Quant's framework-neutral research interface engine",
  "exports": {
    ".": {
      "types": "./engine/index.d.ts",
      "import": "./engine/index.js"
    },
    "./styles.css": "./engine/styles.css",
    "./charts": "./engine/charts.js",
    "./table": "./engine/table.js"
  },
  "files": [
    "engine",
    "vendor",
    "demo",
    "index.html",
    "README.md",
    "API.md",
    "research",
    "QA.md",
    "tests",
    "DESIGN-GUIDELINES.md",
    "review.html",
    "screenshots/latest",
    "RELEASE.md"
  ],
  "scripts": {
    "dev": "python3 -m http.server 4400 --bind 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check engine/touch.js && node --check engine/drag.js && node --check engine/index.js && node --check engine/charts.js && node --check engine/table.js && node --check engine/metrics.js && node --check engine/tokens.js && node --check engine/compare.js && node --check demo/app.js && node --check demo/research-view.js"
  },
  "devDependencies": {
    "jsdom": "29.1.1"
  }
}
