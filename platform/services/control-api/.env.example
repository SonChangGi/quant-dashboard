# Local development is intentionally non-dispatching by default.
QUANT_CONTROL_PROVIDER=disabled
QUANT_CONTROL_ENV=development
QUANT_CONTROL_STORE=memory

# GitHub Actions dispatch is opt-in and server-only. When enabled, the service
# requires QUANT_CONTROL_STORE=supabase and QUANT_CONTROL_DISPATCH_PUMP_ENABLED=true
# in every environment.
QUANT_CONTROL_GITHUB_ENABLED=false
QUANT_CONTROL_GITHUB_TOKEN=
QUANT_CONTROL_GITHUB_OWNER=SonChangGi
QUANT_CONTROL_GITHUB_REPO=best-factor
QUANT_CONTROL_GITHUB_WORKFLOW=update-dashboard.yml
QUANT_CONTROL_GITHUB_REF=main
QUANT_CONTROL_MOMENTUM_GITHUB_OWNER=SonChangGi
QUANT_CONTROL_MOMENTUM_GITHUB_REPO=momentum-factor-lab
QUANT_CONTROL_MOMENTUM_GITHUB_WORKFLOW=controlled-analysis.yml
QUANT_CONTROL_MOMENTUM_GITHUB_REF=main
QUANT_CONTROL_FEAR_GITHUB_OWNER=SonChangGi
QUANT_CONTROL_FEAR_GITHUB_REPO=fearNgreed
QUANT_CONTROL_FEAR_GITHUB_WORKFLOW=controlled-analysis.yml
QUANT_CONTROL_FEAR_GITHUB_REF=main
# Owner-only control token. This is not a VITE_/NEXT_PUBLIC_ browser secret.
QUANT_CONTROL_RUN_API_TOKEN=
# Separate secret used only by the external worker result callback.
QUANT_CONTROL_WORKER_CALLBACK_TOKEN=
QUANT_CONTROL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://sonchanggi.github.io

# Production and every GitHub Actions provider deployment must use Supabase.
# Prefer the current opaque secret key. The legacy service-role JWT remains a
# fallback for existing projects. Set only one. Both are server-only.
QUANT_CONTROL_SUPABASE_DUAL_WRITE_ENABLED=false
QUANT_CONTROL_SUPABASE_URL=
QUANT_CONTROL_SUPABASE_SECRET_KEY=
# QUANT_CONTROL_SUPABASE_SERVICE_ROLE_KEY=

# The durable dispatch pump is required whenever GitHub Actions is enabled.
# Momentum's worker can run for 180 minutes, so the result deadline defaults
# to four hours.
QUANT_CONTROL_DISPATCH_PUMP_ENABLED=false
QUANT_CONTROL_DISPATCH_LEASE_SECONDS=30
QUANT_CONTROL_DISPATCH_MAX_ATTEMPTS=5
QUANT_CONTROL_DISPATCH_RETRY_BASE_SECONDS=2
QUANT_CONTROL_DISPATCH_RETRY_MAX_SECONDS=300
QUANT_CONTROL_DISPATCH_POLL_MILLISECONDS=1000
QUANT_CONTROL_DISPATCH_BATCH_SIZE=4
QUANT_CONTROL_WORKER_RESULT_TIMEOUT_SECONDS=14400
QUANT_CONTROL_WORKER_EXPIRY_SCAN_SECONDS=30
QUANT_CONTROL_WORKER_EXPIRY_BATCH_SIZE=20
